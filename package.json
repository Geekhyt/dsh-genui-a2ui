{
  "name": "dsh-genui-a2ui",
  "version": "0.1.0",
  "description": "Turn DeepSeek Harness conversations into interactive dashboards, 14 chart types, Mermaid diagrams, instant what-if calculators, code diff review gates, and live task trackers.",
  "license": "MIT",
  "author": "Geekhyt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geekhyt/dsh-genui-a2ui.git"
  },
  "homepage": "https://github.com/Geekhyt/dsh-genui-a2ui#readme",
  "bugs": {
    "url": "https://github.com/Geekhyt/dsh-genui-a2ui/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "icon": "./assets/icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./assets/icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.runtime.js",
    "lib/client.echarts.js",
    "lib/client.mermaid.js",
    "cordis.patch.yml",
    "assets/icon.svg",
    "assets/screenshots/hero-executive-dashboard.png",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "genui",
    "a2ui",
    "generative-ui",
    "agent-ui",
    "echarts",
    "mermaid"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "dsh": ">=0.2.0-0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node --no-warnings ./node_modules/tsdown/dist/run.mjs --config-loader native",
    "prepack": "npm run build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:host-api": "node scripts/check-host-api.mjs",
    "dev:env": "node scripts/dev-env.mjs",
    "dev:mock": "node scripts/mock-llm.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "overrides": {
    "@a2ui/markdown-it": {
      "@a2ui/web_core": "$@a2ui/web_core"
    },
    "dompurify": "^3.4.17",
    "katex": "^0.19.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.2.0-0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@a2ui/agent": "0.1.0",
    "@a2ui/react": "0.15.0",
    "@a2ui/web_core": "0.15.0",
    "@biomejs/biome": "^2.6.7",
    "@deepseek-ai/cordis": "^4.1.0",
    "@tanstack/react-table": "^9.3.1",
    "@types/node": "^22.20.5",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "echarts": "^6.1.0",
    "lightningcss": "^1.32.0",
    "mermaid": "^11.17.2",
    "react": "18.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "18.3.1",
    "tsdown": "0.23.7",
    "typescript": "^5.9.3",
    "vitest": "4.1.12",
    "zod": "^3.25.76"
  }
}
