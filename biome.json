{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "build/**",
      "scripts/**",
      "tests/**",
      "locale/**",
      "tsdown.config.ts",
      "package.json",
      "tsconfig.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "useKeyWithClickEvents": "off",
        "noStaticElementInteractions": "off",
        "useSemanticElements": "off",
        "noSvgWithoutTitle": "off",
        "useMediaCaption": "off",
        "useFocusableInteractive": "off",
        "noNoninteractiveElementToInteractiveRole": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noDescendingSpecificity": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "off",
        "noControlCharactersInRegex": "off",
        "noApproximativeNumericConstant": "off",
        "noAssignInExpressions": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/client/catalog/ExtendedWidgets.tsx"],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": {
                    "importNames": ["useEffect", "useLayoutEffect"],
                    "message": "Business and UI .tsx components must not use useEffect/useLayoutEffect (vercel-react-best-practices: rerender-derived-state-no-effect, rerender-move-effect-to-event). Derive state in render, subscribe via useSyncExternalStore, or isolate imperative DOM/Canvas bindings in src/client/dom-hooks.ts."
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
